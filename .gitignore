# DrishtiX Git Ignore Rules

# Environment & Secret Files (CRITICAL - NEVER COMMIT SECRETS)
.env
.env*.local
.env.production
.env.development
*.pem
*.key
*.cert
secrets/

# Dependencies
node_modules/
frontend/node_modules/
venv/
.venv/
env/
ENV/
pythonenvs/

# Python Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Next.js Build Outputs & Cache
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/

# Database & SQLite files
*.db
*.sqlite
*.sqlite3
drishtix.db

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
scratch/
tmp/
temp/

# IDE & OS Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
